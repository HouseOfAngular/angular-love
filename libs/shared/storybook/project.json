{
  "name": "storybook",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/storybook/src",
  "prefix": "al",
  "projectType": "library",
  "tags": [],
  "targets": {
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "continuous": true,
      "options": {
        "port": 4400,
        "configDir": "libs/shared/storybook/.storybook",
        "browserTarget": "storybook:build-storybook",
        "styles": [
          "libs/shared/storybook/.storybook/main.scss",
          "libs/shared/assets/src/lib/styles/main.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared/assets/src/lib/styles"]
        },
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      },
      "readyWhen": {
        "port": "{env.SBCONFIG_PORT ?? options.port ?? 9009}",
        "host": "{env.SBCONFIG_HOSTNAME ?? options.host ?? localhost}"
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/storybook",
        "configDir": "libs/shared/storybook/.storybook",
        "browserTarget": "storybook:build-storybook",
        "styles": [
          "libs/shared/storybook/.storybook/main.scss",
          "libs/shared/assets/src/lib/styles/main.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared/assets/src/lib/styles"]
        },
        "compodoc": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  }
}
