# Copy to libs/blog-bff/jobs/api/.env.local and fill in. Never commit real values.

# Blog database (sync). A file: URL needs no token.
DATABASE_URL=file:tmp/blog-jobs/local.db
DATABASE_AUTH_TOKEN=

# Turso Platform API (rebuild, cleanup)
TURSO_ORG=
TURSO_API_TOKEN=
# Database replaced by rebuild
TURSO_DB_NAME=

# WordPress REST API (sync, rebuild)
WP_REST_API_BASE_URL=https://wp.angular.love
# Full Authorization header value, e.g. "Basic <base64>"
WP_REST_API_TOKEN=
